.com/JDVance/status/2091979408537960769","published_at":"2026-08-24T20:02:12.750Z","published_date":"2026-08-24","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"If an American corporation needs workers, it should hire and train Americans.","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":81762,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2091199902562840930","post_id":"2091199902562840930","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2091199902562840930","published_at":"2026-08-22T16:24:44.043Z","published_date":"2026-08-22","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"A big thanks to the staff of Waffle House in Cincy for great food and great service!","post_kind":"original","is_repost":false,"author_verified":true,"like_count":65690,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2091141927013871954","post_id":"2091141927013871954","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2091141927013871954","published_at":"2026-08-22T12:34:21.595Z","published_date":"2026-08-22","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"RT @AndrewKolvet: Vice President J.D. Vance told the story of Kevin Flanagan: a computer programmer forced to train his foreign replacement…","post_kind":"original","is_repost":false,"author_verified":true,"like_count":null,"likes_captured_at":null,"likes_source":null,"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2090904924779364651","post_id":"2090904924779364651","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2090904924779364651","published_at":"2026-08-21T20:52:35.859Z","published_date":"2026-08-21","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Returning today as the Vice President of the United States, standing in the exact steel mill where my Papaw worked for decades to put food on the table, I couldn’t help but feel immense pride.\n\nPride not only of where I came from and the impact places like this had on who I became, but proud to share the amazing news of investment being made here in Middletown, Ohio.\n\nThanks to President Trump’s economic agenda that puts America First, the future of the United States is not going to be sold out to the highest foreign bidder. The future of American industry and manufacturing is going to be built in towns all across these great United States.","post_kind":"original","is_repost":false,"author_verified":true,"like_count":36278,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2090417240365515051","post_id":"2090417240365515051","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2090417240365515051","published_at":"2026-08-20T12:34:42.834Z","published_date":"2026-08-20","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"James Braid had one of the toughest jobs in the entire Administration as White House Legislative Director and delivered for President Trump at every turn. He played a critical role in all of the administration’s achievements in Congress: largest tax cut ever, resources to carry out President Trump's historic immigration agenda and finish the border wall, defeating two Democratic shutdowns, a landmark first crypto bill, the fastest confirmation of the cabinet in decades and much more. \n\nNot only is James brilliant, he is one of the hardest workers you will ever meet. He’s been with me in every fight I’ve been in, from day one in my senate office through the transition and the President's transformative second term. He has served the President with distinction and I couldn't be prouder of h…","post_kind":"original","is_repost":false,"author_verified":true,"like_count":5830,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":true},{"id":"x-2088224009552863276","post_id":"2088224009552863276","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2088224009552863276","published_at":"2026-08-14T11:19:35.860Z","published_date":"2026-08-14","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Great article by Steve Cortes on the  manufacturing boom we’re seeing build in the US. Donald Trump’s policies are causing a generational shift in our economy.\n\ndailysignal.com/2026/08/11/q…","post_kind":"original","is_repost":false,"author_verified":true,"like_count":9152,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2087939911747834289","post_id":"2087939911747834289","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2087939911747834289","published_at":"2026-08-13T16:30:41.665Z","published_date":"2026-08-13","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"This Administration will not stand idly by while some in the medical community harm our children in search of profit. That is why today I am referring this matter to the Department of Justice to launch a federal criminal investigation. We will stop this fraud and restore trust in public health.\n\nThanks to @SecKennedy, @ADM_Christine and @AGToddBlanche for their tremendous work to shed light on the disastrous consequences of these radical practices. I look forward to working with @TheJusticeDept to ensure we hold anyone who has violated federal law accountable.","post_kind":"original","is_repost":false,"author_verified":true,"like_count":11190,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2087939909239677308","post_id":"2087939909239677308","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2087939909239677308","published_at":"2026-08-13T16:30:41.067Z","published_date":"2026-08-13","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"For years now, some hospitals and healthcare providers have been subjecting children to horrific, experimental treatments in service of radical gender ideologies.  Today, thanks to the Wolves in White Coats report released by @HHSGov, we know why: profit.  It turns out that convincing vulnerable children to reject their gender can create patients for life, earning hospitals tens of thousands of dollars in additional revenue per child.\n\nThe report contains deeply disturbing allegations, and I encourage every American and every parent, to read it.  More than just pushing these procedures on kids, hospitals and providers may have been defrauding Medicaid and private insurers by using misleading or fraudulent billing codes to get insurance to cover the costs.","post_kind":"original","is_repost":false,"author_verified":true,"like_count":67142,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2087649528354677129","post_id":"2087649528354677129","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2087649528354677129","published_at":"2026-08-12T21:16:48.869Z","published_date":"2026-08-12","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Karoline Leavitt has one of the hardest jobs in the Administration — dealing with the relentless attacks from the fake news media. She did the job with grace, wit and a smile on her face. She’s been one of the most effective voices in articulating and defending the President’s agenda, and I’m incredibly grateful to her. I’ve had the opportunity to get to know Karoline over the past few years, and I know how difficult yet rewarding a constant job like this can be for a young parent. We’re sad to see her go, but I know she’ll continue to do great things.","post_kind":"quote","is_repost":false,"author_verified":true,"like_count":83379,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","sha256":"1e128c693c1f2b09bc9c2bfd899d0f839f6bac3803b0864fdd734cb007bff35e","count_precision":"exact-displayed-integer","capture_precision":"collection-run-start","selection_policy":"latest-known-snapshot; minimum on same-time conflict"},"text_status":"captured_displayed_source_text","text_source":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAAAIAAA","text_truncated":false},{"id":"x-2086803168344645976","post_id":"2086803168344645976","platform":"x","author":"JDVance","original_url":"https://x.com/JDVance/status/2086803168344645976","published_at":"2026-08-10T13:13:40.918Z","published_date":"2026-08-10","date_precision":"millisecond","source_ids":["nitter-public-timeline"],"text":"Congratulations to both Dave and Will. Dave has been a true asset to the President over the last several years and has served in his role with the highest integrity. Everyone in the White House will be sad to see him go but incredibly excited to see what he does next. Will is whip-smart and will serve the President well as Counsel. Excited for them both!","post_kind":"original","is_repost":false,"author_verified":true,"like_count":8390,"likes_captured_at":"2026-10-28T23:51:54.990547+00:00","likes_source":{"provider":"nitter-public-timeline","url":"https://nitter.jaydenha.uk/JDVance/with_replies?cursor=DAAHCgABHVwYd0q__7ALAAIAAAATMjA5NDUzMzk2OTU1NTM3ODMxOAgAAwAAA